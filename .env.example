# Copy to .env and fill in real values. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=desgro
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=desgro_erp
POSTGRES_PORT=5432

# --- API ---
API_PORT=4000
NODE_ENV=development

# Local (non-Docker) dev connects straight to localhost; inside docker-compose
# the api service overrides this to point at the `db` service instead.
DATABASE_URL=postgresql://desgro:change_me_locally@localhost:5432/desgro_erp

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Exact frontend origin — never "*", credentials (the refresh cookie) require it.
CORS_ORIGIN=http://localhost:4000
# Set true once this is served over HTTPS. Left false for plain-HTTP local dev,
# since a Secure cookie is silently dropped by the browser over http://.
COOKIE_SECURE=false

BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Used once by `prisma db seed` to create the first login. Change this
# password immediately after the first sign-in.
SEED_ADMIN_EMAIL=admin@desgromedia.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
