// DesGro Media ERP — Phase 1 + Phase 2 + Phase 3 schema
// Phase 1: auth/RBAC/audit. Phase 2: HR module. Phase 3 (bottom of file):
// Finance — invoices, payables, expenses, bank ledger, chart of accounts,
// journal entries, commissions — replacing the in-memory JS arrays in
// app.js. CRM/Content (Phase 4) tables still to come.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the musl target is needed for the
  // node:20-alpine Docker image (musl libc, not glibc) — without it the
  // engine binary can't find a matching OpenSSL at runtime and crashes
  // with an unparseable error on `prisma migrate deploy`/`db seed`.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// One enum value per department module in the ACCESS MODEL. ADMIN is a
// superset — requireRole() treats it as satisfying every check. EMPLOYEE
// is the implicit base role every account has, used for "see only your
// own HR record" style checks in later phases.
enum Role {
  ADMIN
  HR
  FINANCE
  SALES
  CONTENT
  EMPLOYEE
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  // A user can hold several department roles at once (e.g. Sales + Content).
  roles        Role[]    @default([EMPLOYEE])
  department   String?
  // Links this login to its HR record — lets the base Employee role resolve
  // "my own record" without a second lookup table. Not every Employee has a
  // User (HR grants ERP access selectively), so this is optional and 1:1.
  employeeId   String?   @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  active       Boolean   @default(true)

  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  postedNotices Notice[]

  @@map("users")
}

// Refresh tokens are opaque random strings, not JWTs — only their SHA-256
// hash is stored, so a stolen DB row can't be replayed as a session on its
// own. Each use rotates the token (old row gets revokedAt + replacedBy);
// presenting an already-revoked token is treated as token theft and kills
// every active session for that user (see auth.service.ts).
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  createdByIp String?   @map("created_by_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Append-only. Nothing in the app ever updates or deletes a row here —
// corrections are new rows, same as the Journal module's own convention.
// Required from Phase 1 on for anything touching money or salary.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}

// =============================================================================
// PHASE 2 — HR MODULE
// Replaces the in-memory `employees`/`leaveRequests`/`advances`/etc arrays in
// public/js/app.js. Salary, bank and other comp fields are HR/Admin-only —
// enforced server-side in the controllers, never just hidden in the UI.
// =============================================================================

enum EmploymentType {
  PERMANENT
  PROBATION
}

// NOTICE_PERIOD keeps full ERP access — it's purely informational until HR
// confirms the departure. LEFT is a soft-archive: never deleted, but their
// linked User (if any) gets active=false and every refresh token revoked
// the moment departure is confirmed — see confirmDeparture() in
// employees.controller.ts.
enum EmploymentStatus {
  ACTIVE
  NOTICE_PERIOD
  LEFT
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  WFH
}

// Simplified from CASUAL/SICK/EARNED/UNPAID — Loss of Pay is now a monthly
// cap on Attendance ON_LEAVE days (see HrPolicy.paidLeavesPerMonth), not a
// per-type annual bank, so the type distinction that fed those banks is
// gone. WFH is a LeaveType (not just an Attendance status) because a WFH
// day still goes through the same request/approval flow as leave — see
// LeaveRequest and the approval-writes-attendance flow in leave.controller.ts.
enum LeaveType {
  CASUAL_SICK
  WFH
}

enum LeaveDuration {
  FULL_DAY
  HALF_DAY
  QUARTER_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdvanceStatus {
  PENDING
  RECOVERING
  RECOVERED
  REJECTED
}

enum ComplaintStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum PositionStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum CandidateStage {
  APPLIED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Employee {
  id           String         @id @default(uuid())
  // Human-facing code ("EMP-101") kept distinct from the internal uuid `id`
  // so existing document/report numbering conventions can carry over.
  employeeCode String         @unique @map("employee_code")
  name         String
  dept         String
  role         String
  dob          DateTime?      @db.Date
  joinedAt     DateTime       @map("joined_at") @db.Date
  email        String         @unique
  phone        String?
  // HR/Admin-only field — filtered out server-side for every other role,
  // including the employee's own "my record" view. See ACCESS MODEL.
  salary       Decimal        @db.Decimal(12, 2)
  empType      EmploymentType @map("emp_type")

  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  // Last working day — set when notice period starts (still tentative,
  // reversible) and again (final) when departure is confirmed.
  leavingDate      DateTime?        @db.Date @map("leaving_date")
  noticeGivenDate  DateTime?        @db.Date @map("notice_given_date")
  noticeNote       String?          @map("notice_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                    User?
  salaryRevisions         SalaryRevision[]
  attendanceRecords       AttendanceRecord[]
  leaveRequests           LeaveRequest[]
  advances                Advance[]
  payrollEntries          PayrollEntry[]
  commissionWithdrawals   CommissionWithdrawal[]
  paymentRequests         PaymentRequest[]
  withdrawalRequests      WithdrawalRequest[]

  @@index([dept])
  @@map("employees")
}

// Append-only — a correction is a new row, not an edit to history. HR/Admin
// only, same as the salary field it revises.
model SalaryRevision {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @map("effective_date") @db.Date
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  @@index([employeeId])
  @@map("salary_revisions")
}

// The old prototype only ever tracked "today's" status in memory — no real
// daily history existed. This is a genuine new table, not a straight port.
model AttendanceRecord {
  id         String           @id @default(uuid())
  employeeId String           @map("employee_id")
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  checkIn    String?          @map("check_in")
  markedBy   String?          @map("marked_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_records")
}

model LeaveRequest {
  id         String        @id @default(uuid())
  employeeId String        @map("employee_id")
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType
  duration   LeaveDuration @default(FULL_DAY)
  fromDate   DateTime      @map("from_date") @db.Date
  toDate     DateTime      @map("to_date") @db.Date
  // Decimal, not Int — half/quarter-day requests are 0.5 / 0.25.
  days       Decimal       @db.Decimal(4, 2)
  reason     String
  status     LeaveStatus   @default(PENDING)
  appliedAt  DateTime      @default(now()) @map("applied_at")
  decidedBy  String?       @map("decided_by")
  decidedAt  DateTime?     @map("decided_at")
  note       String?

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model Advance {
  id               String        @id @default(uuid())
  employeeId       String        @map("employee_id")
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  reason           String
  requestedAt      DateTime      @default(now()) @map("requested_at")
  installments     Int
  monthlyDeduction Decimal       @map("monthly_deduction") @db.Decimal(12, 2)
  balance          Decimal       @db.Decimal(12, 2)
  status           AdvanceStatus @default(PENDING)
  decidedBy        String?       @map("decided_by")
  decidedAt        DateTime?     @map("decided_at")
  // Set only once Finance actually pays the lump sum out — separate from
  // decidedBy/decidedAt (HR's approve/reject call), same "decide vs pay"
  // split as PaymentRequest. Recovery afterward happens automatically out
  // of payroll (installments/monthlyDeduction/balance above), so this is a
  // one-time payout, not a balance Finance pays down over multiple visits.
  paidDate         DateTime?     @map("paid_date") @db.Date
  paidBy           String?       @map("paid_by")
  accountId        String?       @map("account_id")
  account          BankAccount?  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@map("advances")
}

// Deliberately has NO employeeId/submitter field of any kind — the original
// design promise is "no name, employee ID or contact info is ever captured."
// The audit log must not record the submitter either (see complaints
// controller) or this guarantee is just moved, not kept.
model Complaint {
  id          String          @id @default(uuid())
  category    String
  dept        String?
  text        String
  submittedAt DateTime        @default(now()) @map("submitted_at")
  status      ComplaintStatus @default(NEW)
  note        String?

  @@map("complaints")
}

model OpenPosition {
  id           String         @id @default(uuid())
  positionCode String         @unique @map("position_code")
  role         String
  dept         String
  openings     Int
  status       PositionStatus @default(OPEN)
  postedDate   DateTime       @default(now()) @map("posted_date")
  archived     Boolean        @default(false)

  candidates Candidate[]

  @@map("open_positions")
}

model Candidate {
  id          String         @id @default(uuid())
  positionId  String         @map("position_id")
  position    OpenPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  stage       CandidateStage @default(APPLIED)
  appliedDate DateTime       @default(now()) @map("applied_date")
  archived    Boolean        @default(false)

  @@index([positionId])
  @@map("candidates")
}

// postedBy is the real authenticated user, not free text — the old prototype
// let HR type any name into a "Posted by" field, which is trivially spoofable
// once notices are attributed for real.
model Notice {
  id           String   @id @default(uuid())
  title        String
  message      String
  postedById   String   @map("posted_by")
  postedByUser User     @relation(fields: [postedById], references: [id])
  postedDate   DateTime @default(now()) @map("posted_date")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("notices")
}

// Singleton config row (id fixed at 1) — HR/Admin-editable leave policy.
model HrPolicy {
  id Int @id @default(1)
  // 0 = Sunday ... 6 = Saturday, matching JS Date#getDay().
  weeklyOff Int @default(0) @map("weekly_off")
  // Org-wide monthly caps, not annual per-type banks — replaces
  // casual/sick/earnedLeaveDays. Days beyond paidLeavesPerMonth marked
  // ON_LEAVE in Attendance in a given payroll month are a full day's Loss
  // of Pay each; days beyond paidWfhPerMonth marked WFH are paid at 75%
  // instead (a 25% cut) — see computeLopDays()/computeWfhExcessDays().
  // Computed from Attendance, not LeaveRequest, so a correction to
  // attendance alone stays correct even if the original request isn't
  // touched. Org-wide for now, not per-employee/per-role.
  paidLeavesPerMonth Int      @default(1) @map("paid_leaves_per_month")
  paidWfhPerMonth    Int      @default(1) @map("paid_wfh_per_month")
  generalNotes       String?  @map("general_notes")
  leavePayNotes      String?  @map("leave_pay_notes")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("hr_policy")
}

// Singleton settings row (id=1, same pattern as HrPolicy above). Lives on
// the Finance side, not HrPolicy — this is a commission-plan setting Finance
// manages, not an HR policy. Drives the monthly-target bonus computed in
// services/finance/salesTarget.ts.
model SalesPolicy {
  id            Int      @id @default(1)
  monthlyTarget Decimal  @default(500000) @db.Decimal(12, 2) @map("monthly_target")
  bonusRate     Decimal  @default(0.10) @db.Decimal(5, 4) @map("bonus_rate")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("sales_policy")
}

model Holiday {
  id   String   @id @default(uuid())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

model PayrollEntry {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // "YYYY-MM" — one entry per employee per calendar month.
  month      String
  gross      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  payments PayrollPayment[]

  @@unique([employeeId, month])
  @@map("payroll_entries")
}

// Append-only — same convention as Finance's journal entries. A correction
// is a new (possibly negative) payment row, never an edit to a past one.
model PayrollPayment {
  id             String       @id @default(uuid())
  payrollEntryId String       @map("payroll_entry_id")
  payrollEntry   PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)
  paidDate       DateTime     @default(now()) @map("paid_date")
  note           String?
  recordedBy     String?      @map("recorded_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  // Set only when this payment is the early payout of an approved salary
  // withdrawal request — see WithdrawalRequest.
  withdrawalRequest WithdrawalRequest?

  @@index([payrollEntryId])
  @@map("payroll_payments")
}

// =============================================================================
// PHASE 3 — FINANCE MODULE
// Replaces the in-memory `invoices`/`payables`/`expenses`/`bankAccounts`/
// `bankTransactions`/`chartOfAccounts`/`journalEntries` arrays in app.js.
// Journal entries and bank transfers are append-only per the project brief —
// the old prototype actually edited journal entries and reposted ledger rows
// in place; corrections here are new entries instead, not a straight port.
// `Invoice.clientId` was a loose string, not a FK, until Phase 4 (below)
// added the real Client table and wired the constraint.
// =============================================================================

enum PayableCategory {
  SALARY
  RENT
  COMMISSION
  SALES_BONUS
  INTERNAL_LOAN
  VENDOR
}

enum BankTxnType {
  CREDIT
  DEBIT
}

// What produced a ledger row — replaces the old untyped `ref` string so a
// transaction can be traced back to its source without guessing.
enum BankTxnRefType {
  INVOICE_PAYMENT
  PAYABLE_PAYMENT
  PAYMENT_REQUEST
  EXPENSE
  TRANSFER
  JOURNAL
  MANUAL
  ADVANCE
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

enum CommissionWithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Invoice {
  id        String   @id @default(uuid())
  invoiceNo String   @unique @map("invoice_no")
  // Was a loose string when Phase 3 shipped (Client didn't exist yet) — now
  // a real FK now that Phase 4 owns the Client table, per the plan the
  // Phase 3 schema comment left for this.
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  issuedAt  DateTime @map("issued_at") @db.Date
  dueAt     DateTime @map("due_at") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items           InvoiceItem[]
  payments        InvoicePayment[]
  pendingPayments InvoicePendingPayment[]
  Quote           Quote[]

  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dept      String
  amount    Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

// Append-only — Finance directly confirming money that's already landed.
// A correction is a new (possibly negative) payment row, never an edit.
model InvoicePayment {
  id         String      @id @default(uuid())
  invoiceId  String      @map("invoice_id")
  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(12, 2)
  paidDate   DateTime    @map("paid_date") @db.Date
  accountId  String      @map("account_id")
  account    BankAccount @relation(fields: [accountId], references: [id])
  note       String?
  recordedBy String?     @map("recorded_by")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_payments")
}

// A Sales-collected payment Finance hasn't confirmed yet. Approving one
// creates the matching InvoicePayment (+ ledger row + commission payable) —
// see the payments controller — and flips `approved` rather than deleting
// this row, so the queue keeps a record of what was submitted and when.
model InvoicePendingPayment {
  id             String    @id @default(uuid())
  invoiceId      String    @map("invoice_id")
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal   @db.Decimal(12, 2)
  paymentDate    DateTime  @map("payment_date") @db.Date
  salesPerson    String?   @map("sales_person")
  note           String?
  approved       Boolean   @default(false)
  approvedAt     DateTime? @map("approved_at")
  invoicePayment String?   @map("invoice_payment_id") // set once approved, points at the resulting InvoicePayment.id
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_pending_payments")
}

model Payable {
  id          String          @id @default(uuid())
  category    PayableCategory
  payee       String
  // Only set on Commission-category rows — see commission auto-creation in
  // the invoice/quote payment-approval controllers.
  salesPerson String?         @map("sales_person")
  amount      Decimal         @db.Decimal(12, 2)
  dueAt       DateTime        @map("due_at") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  payments PayablePayment[]

  @@index([category])
  @@map("payables")
}

// Append-only, same convention as every other payment table.
model PayablePayment {
  id         String      @id @default(uuid())
  payableId  String      @map("payable_id")
  payable    Payable     @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount     Decimal     @db.Decimal(12, 2)
  paidDate   DateTime    @map("paid_date") @db.Date
  accountId  String      @map("account_id")
  account    BankAccount @relation(fields: [accountId], references: [id])
  note       String?
  recordedBy String?     @map("recorded_by")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([payableId])
  @@map("payable_payments")
}

model Expense {
  id           String         @id @default(uuid())
  // FK into the same Chart of Accounts used by journal entries, instead of
  // a fixed enum — so the category list an expense can be logged against
  // always matches whatever Expense/Liability accounts Settings > Chart of
  // Accounts actually has, and P&L can total expenses straight off
  // coaAccount.name instead of a separately-maintained label mapping.
  coaAccountId String         @map("coa_account_id")
  coaAccount   ChartOfAccount @relation(fields: [coaAccountId], references: [id])
  description  String
  amount       Decimal        @db.Decimal(12, 2)
  date         DateTime       @db.Date
  accountId    String         @map("account_id")
  account      BankAccount    @relation(fields: [accountId], references: [id])
  // Untagged (null) expenses pool into shared overhead in department
  // profitability — see deptProfitability() in app.js.
  dept         String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([coaAccountId])
  @@map("expenses")
}

model BankAccount {
  id       String   @id @default(uuid())
  name     String
  bank     String
  number   String
  // Never mutated once transactions exist in practice — the balance is
  // always opening + sum(ledger), so changing this after the fact would
  // silently reshape every derived historical balance.
  opening  Decimal  @db.Decimal(12, 2)
  openedAt DateTime @map("opened_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions    BankTransaction[]
  invoicePayments InvoicePayment[]
  payablePayments PayablePayment[]
  paymentRequests PaymentRequest[]
  expenses        Expense[]
  transfersFrom   Transfer[]        @relation("TransferFrom")
  transfersTo     Transfer[]        @relation("TransferTo")
  advances        Advance[]

  @@map("bank_accounts")
}

// Append-only — the single source of truth for cash movement. Balances are
// always derived (opening + sum(credits) - sum(debits)), never stored, so
// they can never drift out of sync with this ledger.
model BankTransaction {
  id        String         @id @default(uuid())
  accountId String         @map("account_id")
  account   BankAccount    @relation(fields: [accountId], references: [id])
  date      DateTime       @db.Date
  type      BankTxnType
  amount    Decimal        @db.Decimal(12, 2)
  note      String?
  refType   BankTxnRefType @map("ref_type")
  refId     String?        @map("ref_id")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([accountId, date])
  @@index([refType, refId])
  @@map("bank_transactions")
}

// A real entity instead of two unlinked ledger rows matched by guessing from
// note text — generates its two BankTransaction legs atomically. Append-only:
// a wrong transfer is corrected with a new reversing transfer.
model Transfer {
  id            String      @id @default(uuid())
  fromAccountId String      @map("from_account_id")
  fromAccount   BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String      @map("to_account_id")
  toAccount     BankAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  date          DateTime    @db.Date
  note          String?
  createdBy     String?     @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("transfers")
}

model ChartOfAccount {
  id       String           @id @default(uuid())
  name     String           @unique
  // Set explicitly at creation (copied from the parent for sub-accounts) —
  // not re-derived by walking the parent chain on every read like the old
  // coaTypeOf() did.
  type     AccountType
  parentId String?          @map("parent_id")
  parent   ChartOfAccount?  @relation("COAChildren", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("COAChildren")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journalLines JournalLine[]
  expenses     Expense[]

  @@map("chart_of_accounts")
}

// Append-only per the project brief — no update/delete anywhere in the API.
// A correction is a new entry (e.g. a reversing entry), never an edit to
// history, unlike the old prototype which rewrote entries and reposted
// ledger rows in place.
model JournalEntry {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  memo      String
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  lines JournalLine[]

  @@map("journal_entries")
}

enum JournalSide {
  DEBIT
  CREDIT
}

// A line posts against a chart-of-accounts entry OR a bank account, never
// both — exactly one of coaAccountId/bankAccountId is set. A bank-account
// line also represents a real cash movement, so posting it creates the
// matching BankTransaction (refType=JOURNAL) in the same DB transaction.
model JournalLine {
  id             String          @id @default(uuid())
  journalEntryId String          @map("journal_entry_id")
  journalEntry   JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  coaAccountId   String?         @map("coa_account_id")
  coaAccount     ChartOfAccount? @relation(fields: [coaAccountId], references: [id])
  bankAccountId  String?         @map("bank_account_id")
  side           JournalSide
  amount         Decimal         @db.Decimal(12, 2)

  @@index([journalEntryId])
  @@map("journal_lines")
}

model CommissionWithdrawal {
  id          String                     @id @default(uuid())
  employeeId  String                     @map("employee_id")
  employee    Employee                   @relation(fields: [employeeId], references: [id])
  amount      Decimal                    @db.Decimal(12, 2)
  note        String?
  requestedAt DateTime                   @default(now()) @map("requested_at")
  status      CommissionWithdrawalStatus @default(PENDING)
  decidedAt   DateTime?                  @map("decided_at")
  accountId   String?                    @map("account_id")
  paidAmount  Decimal?                   @map("paid_amount") @db.Decimal(12, 2)

  @@index([employeeId])
  @@map("commission_withdrawals")
}

enum PaymentRequestCategory {
  REIMBURSEMENT
  TRAVEL
  PURCHASE_VENDOR
  OTHER
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Money OUT to an employee for anything that isn't salary — a reimbursement,
// travel, a purchase they fronted. Any employee with a linked login can raise
// one; it skips HR and goes straight to Finance/Admin, who approve-and-pay in
// one step (choose the account + date) or reject. The debit is a single
// BankTransaction (refType PAYMENT_REQUEST, refId = this row's id), written in
// the same DB transaction that flips status to APPROVED, so the request and
// the ledger can never disagree. Distinct from Advance (salary, HR-approved).
model PaymentRequest {
  id          String                 @id @default(uuid())
  employeeId  String                 @map("employee_id")
  employee    Employee               @relation(fields: [employeeId], references: [id])
  category    PaymentRequestCategory
  amount      Decimal                @db.Decimal(12, 2)
  reason      String
  requestedAt DateTime               @default(now()) @map("requested_at")
  status      PaymentRequestStatus   @default(PENDING)
  // Who decided and when — a User id (plain string, same convention as
  // Advance.decidedBy / PayrollPayment.recordedBy). Also in the audit log.
  decidedBy   String?                @map("decided_by")
  decidedAt   DateTime?              @map("decided_at")
  // Set only when APPROVED (paid).
  paidDate    DateTime?              @map("paid_date") @db.Date
  accountId   String?                @map("account_id")
  account     BankAccount?           @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@map("payment_requests")
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Salary ALREADY EARNED in a CLOSED payroll month but not yet paid out on the
// scheduled run, asked for early. Deliberately not an Advance: an Advance is
// against the current, still-open month (HR-approved, recovered from payroll);
// this is a plain early payment with nothing to recover. Not to be confused
// with CommissionWithdrawal above, which draws down sales commission.
//
// The employee supplies only an amount. The month is derived server-side (the
// most recently closed one) and the amount is checked against that month's
// earned-but-unpaid balance both when the request is raised and again when it's
// approved — a client-supplied figure is never trusted. Approving writes the
// early PayrollPayment (linked back here) so the scheduled run only owes the
// remainder. Finance/Admin decide; every decision is audit-logged.
model WithdrawalRequest {
  id               String                  @id @default(uuid())
  employeeId       String                  @map("employee_id")
  employee         Employee                @relation(fields: [employeeId], references: [id])
  // "YYYY-MM" of the closed payroll month being drawn against.
  month            String
  amount           Decimal                 @db.Decimal(12, 2)
  requestedAt      DateTime                @default(now()) @map("requested_at")
  status           WithdrawalRequestStatus @default(PENDING)
  // A User id, same convention as PaymentRequest.decidedBy. Also in the audit log.
  decidedBy        String?                 @map("decided_by")
  decidedAt        DateTime?               @map("decided_at")
  // The early payment recorded on approval.
  payrollPaymentId String?                 @unique @map("payroll_payment_id")
  payrollPayment   PayrollPayment?         @relation(fields: [payrollPaymentId], references: [id], onDelete: Restrict)

  @@index([employeeId, month, status])
  @@index([status])
  @@map("withdrawal_requests")
}

// =============================================================================
// PHASE 4 — CRM + CONTENT
// Replaces the in-memory `clients`/`marketingLeads`/`quotes`/`clientTasks`/
// `contentItems`/`metaAdsCampaigns` arrays in app.js. CRM (clients, leads,
// quotes, tasks) is Sales/Admin; Content Pipeline is Content/Admin — a
// deliberate tightening versus the old prototype, which let any non-HR,
// non-Sales "Staff" employee view Marketing/Content (quotes/invoices
// excluded) with no real role boundary. accountManager/salesPerson/
// leadOwner/createdBy stay plain name strings, matching the existing
// convention on Payable.salesPerson from Phase 3 — not worth a wider FK
// normalization nobody asked for.
// =============================================================================

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum BillingType {
  PREPAID
  POSTPAID
}

model Client {
  id             String       @id @default(uuid())
  // Human-facing code ("CLI-01") — same pattern as Employee.employeeCode.
  clientCode     String       @unique @map("client_code")
  name           String
  industry       String?
  city           String?
  // Subset of the department list, e.g. ["Marketing Consultation"].
  services       String[]
  status         ClientStatus @default(ACTIVE)
  billingType    BillingType  @default(PREPAID) @map("billing_type")
  onboardedAt    DateTime     @map("onboarded_at") @db.Date
  accountManager String?      @map("account_manager")
  salesPerson    String?      @map("sales_person")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices Invoice[]
  leads    Lead[]
  quotes   Quote[]
  tasks    ClientTask[]

  @@map("clients")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id                String     @id @default(uuid())
  leadCode          String     @unique @map("lead_code")
  name              String
  phone             String?
  email             String?
  source            String
  serviceInterested String     @map("service_interested")
  leadOwner         String?    @map("lead_owner")
  status            LeadStatus @default(NEW)
  // Set once a quote against this lead gets its first approved payment —
  // the old prototype never recorded this, so a converted lead just sat in
  // the list forever with no indication. Fixed here, not a straight port.
  convertedClientId String?    @map("converted_client_id")
  convertedClient   Client?    @relation(fields: [convertedClientId], references: [id])
  createdAt         DateTime   @default(now()) @map("created_at")

  quotes Quote[]

  @@map("leads")
}

enum QuoteStatus {
  DRAFT
  SENT
  SUBMITTED_TO_FINANCE
  INVOICED
  LOST
}

model Quote {
  id        String      @id @default(uuid())
  quoteCode String      @unique @map("quote_code")
  // Exactly one of clientId/leadId is set — enforced in the controller, not
  // the DB (a simple nullable-pair is enough here; a CHECK constraint would
  // be belt-and-braces for two columns nothing else joins against).
  clientId  String?     @map("client_id")
  client    Client?     @relation(fields: [clientId], references: [id])
  leadId    String?     @map("lead_id")
  lead      Lead?       @relation(fields: [leadId], references: [id])
  title     String
  createdBy String?     @map("created_by")
  status    QuoteStatus @default(DRAFT)
  sentAt    DateTime?   @map("sent_at") @db.Date
  // Set once the first payment is approved, then only topped up.
  invoiceId String?     @map("invoice_id")
  invoice   Invoice?    @relation(fields: [invoiceId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")

  items           QuoteItem[]
  pendingPayments QuotePendingPayment[]

  @@map("quotes")
}

model QuoteItem {
  id      String  @id @default(uuid())
  quoteId String  @map("quote_id")
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  dept    String
  amount  Decimal @db.Decimal(12, 2)

  @@index([quoteId])
  @@map("quote_items")
}

// Sales-submitted, Finance-approved — same pattern as
// InvoicePendingPayment. Approving one creates the real InvoicePayment
// (+ ledger row + commission payable) via the Finance services, reusing
// them rather than re-implementing bank-ledger/commission logic here.
model QuotePendingPayment {
  id             String    @id @default(uuid())
  quoteId        String    @map("quote_id")
  quote          Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  amount         Decimal   @db.Decimal(12, 2)
  paymentDate    DateTime  @map("payment_date") @db.Date
  note           String?
  approved       Boolean   @default(false)
  approvedAt     DateTime? @map("approved_at")
  invoicePayment String?   @map("invoice_payment_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([quoteId])
  @@map("quote_pending_payments")
}

enum ClientTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model ClientTask {
  id         String           @id @default(uuid())
  clientId   String           @map("client_id")
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  assignedTo String?          @map("assigned_to")
  dueAt      DateTime         @map("due_at") @db.Date
  status     ClientTaskStatus @default(TODO)
  revisions  Int              @default(0)
  doneAt     DateTime?        @map("done_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  attachments TaskAttachment[]

  @@map("client_tasks")
}

// Metadata only — no real file storage exists yet (the old prototype was
// explicit that this was mockup-only); a real upload pipeline is future
// work, not invented here as a side effect of the CRM migration.
model TaskAttachment {
  id      String     @id @default(uuid())
  taskId  String     @map("task_id")
  task    ClientTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name    String
  size    Int
  addedAt DateTime   @default(now()) @map("added_at")

  @@index([taskId])
  @@map("task_attachments")
}

enum ContentStage {
  IDEA
  SCRIPTING
  PRODUCTION
  REVIEW
  SCHEDULED
  PUBLISHED
}

model ContentItem {
  id        String       @id @default(uuid())
  title     String
  // Free-text in the old prototype (a <select> with hardcoded options, no
  // central enum) — kept as a plain string rather than inventing a rigid
  // enum for a field the UI already treats as open-ended.
  type      String
  platforms String[]
  assignee  String?
  stage     ContentStage @default(IDEA)
  dueAt     DateTime     @map("due_at") @db.Date
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_items")
}

enum MetaAdsCampaignStatus {
  ACTIVE
  PAUSED
}

// Read-only in the old prototype (pure seed data, no add/edit/delete UI
// anywhere) — full CRUD added here since a real multi-user system needs a
// way to actually enter this data, but there's no live Meta integration to
// sync from, so these are entered by hand until one exists.
model MetaAdsCampaign {
  id          String                @id @default(uuid())
  name        String
  objective   String
  platform    String
  status      MetaAdsCampaignStatus @default(ACTIVE)
  spend       Decimal               @db.Decimal(12, 2)
  impressions Int
  clicks      Int
  leads       Int
  startAt     DateTime              @map("start_at") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meta_ads_campaigns")
}
